# SafarAI environment template — copy to .env.local and fill in your keys.
# The app degrades gracefully without them:
#  • no Groq key  -> the assistant answers from the built-in datasets
#  • no Supabase  -> the product runs in local (guest) mode

VITE_GROQ_API_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
